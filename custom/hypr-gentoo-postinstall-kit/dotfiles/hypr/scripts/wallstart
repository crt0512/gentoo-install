#!/usr/bin/env bash
set -euo pipefail

WALL_DIR="${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
LAST="$HOME/.cache/hypr-last-wall"

if [ -f "$LAST" ] && [ -s "$LAST" ]; then
  WALL="$(cat "$LAST")"
else
  # PNG, JPG, JPEG supported by swaybg
  WALL="$(find "$WALL_DIR" -maxdepth 4 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) | sort | head -n1 || true)"
fi

[ -n "${WALL:-}" ] || exit 0

pkill -x hyprpaper 2>/dev/null || true
pkill -x swaybg 2>/dev/null || true
swaybg -i "$WALL" -m fill >/dev/null 2>&1 &
